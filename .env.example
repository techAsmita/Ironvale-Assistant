# Copy to .env and fill in. Never commit .env.

# LLM: any OpenAI-compatible API. Groq (free tier) by default; for OpenAI use
# LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=llama-3.1-8b-instant

# Postgres with pgvector (local Docker, or Neon/Supabase for the deployed app)
DATABASE_URL=postgresql://ironvale:ironvale@localhost:5432/ironvale

# Neo4j (local Docker, or Neo4j AuraDB Free for the deployed app)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ironvale-graph

# Langfuse (local Docker on :3001, or Langfuse Cloud)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-ironvale
LANGFUSE_SECRET_KEY=sk-lf-local-ironvale

# Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_THRESHOLD=0.30

# Frontend origin allowed by the API (Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
